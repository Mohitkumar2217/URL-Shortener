<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head') %>
  </head>
  <body class="auth-page">
    <%- include('partials/navbar') %>
    <main class="auth-main">
      <div class="auth-card">
        <h1>Create Account</h1>
        <p class="subtitle">Join LinkSnap and start shortening URLs</p>

        <% if (locals.error) { %>
        <div class="alert-error-custom"><%= error %></div>
        <% } %>

        <form action="/user" method="post">
          <div class="mb-3">
            <label for="fullName" class="form-label">Full Name</label>
            <input type="text" required name="name" id="fullName" class="form-control" placeholder="John Doe" />
          </div>
          <div class="mb-3">
            <label for="fullEmail" class="form-label">Email</label>
            <input type="email" required name="email" id="fullEmail" class="form-control" placeholder="you@example.com" />
          </div>
          <div class="mb-3">
            <label for="fullPassword" class="form-label">Password</label>
            <input type="password" required name="password" id="fullPassword" class="form-control" placeholder="Create a password" />
          </div>
          <div class="mb-3">
            <label for="fullcPassword" class="form-label">Confirm Password</label>
            <input type="password" required name="confirmpass" id="fullcPassword" class="form-control" placeholder="Confirm your password" />
          </div>
          <button type="submit" class="btn btn-primary-custom">Sign Up</button>
        </form>

        <div class="auth-footer-link">
          Already have an account? <a href="/login">Sign in</a>
        </div>
      </div>
    </main>
    <%- include('partials/scripts') %>
  </body>
</html>
