<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head') %>
  </head>
  <body>
    <%- include('partials/navbar') %>
    <div class="page-wrapper">
      <%- include('partials/breadcrumb') %>

      <div class="container-app">
        <div class="page-header">
          <h1>Admin Dashboard</h1>
          <p>Overview of all users and shortened links across the platform.</p>
        </div>

        <div class="row g-3 mb-4">
          <div class="col-sm-4">
            <div class="stat-card">
              <div class="stat-value"><%= totalUsers %></div>
              <div class="stat-label">Total Users</div>
            </div>
          </div>
          <div class="col-sm-4">
            <div class="stat-card">
              <div class="stat-value"><%= urls.length %></div>
              <div class="stat-label">Total Links</div>
            </div>
          </div>
          <div class="col-sm-4">
            <div class="stat-card">
              <div class="stat-value"><%= totalClicks %></div>
              <div class="stat-label">Total Clicks</div>
            </div>
          </div>
        </div>

        <% if (urls.length) { %>
        <div class="table-wrapper">
          <table class="table table-custom table-hover">
            <thead>
              <tr>
                <th>#</th>
                <th>Short Link</th>
                <th>Original URL</th>
                <th>User</th>
                <th>Clicks</th>
              </tr>
            </thead>
            <tbody>
              <% urls.forEach(function(url, index) { %>
              <tr>
                <td><%= index + 1 %></td>
                <td>
                  <a href="<%= baseUrl %>/url/<%= url.shortId %>" target="_blank">
                    /url/<%= url.shortId %>
                  </a>
                </td>
                <td class="url-cell" title="<%= url.redirectId %>"><%= url.redirectId %></td>
                <td><%= url.createdBy ? url.createdBy.email : 'Unknown' %></td>
                <td><span class="click-badge"><%= url.visitHistory.length %></span></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <% } else { %>
        <div class="empty-state glass-card">
          <div class="empty-state-icon">📊</div>
          <h5>No data yet</h5>
          <p>No links have been created on the platform.</p>
        </div>
        <% } %>
      </div>
    </div>
    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
  </body>
</html>
