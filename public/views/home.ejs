<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head') %>
  </head>
  <body>
    <%- include('partials/navbar') %>
    <div class="page-wrapper">
      <%- include('partials/breadcrumb') %>

      <div class="container-app">
        <div class="page-header">
          <h1>Shorten Your Links</h1>
          <p>Paste a long URL below and get a short, shareable link instantly.</p>
        </div>

        <% if (locals.id) { %>
        <div class="alert-success-custom mb-4">
          <p class="mb-2 fw-semibold">Your short URL is ready!</p>
          <div class="short-link-row justify-content-center">
            <a href="<%= baseUrl %>/url/<%= id %>" class="short-url" target="_blank">
              <%= baseUrl %>/url/<%= id %>
            </a>
            <button class="btn-copy" data-url="<%= baseUrl %>/url/<%= id %>" type="button">Copy</button>
          </div>
        </div>
        <% } %>

        <div class="glass-card mb-5">
          <form method="POST" action="/url">
            <label for="Original_URL" class="form-label">Original URL</label>
            <input
              type="url"
              name="url"
              id="Original_URL"
              class="form-control mb-3"
              placeholder="https://example.com/your-long-url"
              required
            />
            <button type="submit" class="btn btn-primary-custom">Shorten URL</button>
          </form>
        </div>

        <% if (locals.urls) { %>
        <h4 class="fw-bold mb-3" style="color: var(--dark);">Recent Links</h4>
        <%- include('partials/url-table') %>
        <% } %>
      </div>
    </div>
    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
  </body>
</html>
