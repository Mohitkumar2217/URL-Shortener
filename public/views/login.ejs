<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head') %>
  </head>
  <body class="auth-page">
    <%- include('partials/navbar') %>
    <main class="auth-main">
      <div class="auth-card">
        <h1>Welcome Back</h1>
        <p class="subtitle">Sign in to manage your shortened links</p>

        <% if (locals.error) { %>
        <div class="alert-error-custom"><%= error %></div>
        <% } %>

        <form action="/login" method="post">
          <div class="mb-3">
            <label for="fullEmail" class="form-label">Email</label>
            <input
              type="email"
              required
              name="email"
              id="fullEmail"
              class="form-control"
              placeholder="you@example.com"
            />
          </div>
          <div class="mb-3">
            <label for="fullPassword" class="form-label">Password</label>
            <input
              type="password"
              required
              name="password"
              id="fullPassword"
              class="form-control"
              placeholder="Enter your password"
            />
          </div>
          <button type="submit" class="btn btn-primary-custom">Sign In</button>
        </form>

        <div class="auth-footer-link">
          Don't have an account? <a href="/signup">Create one</a>
        </div>
      </div>
    </main>
    <%- include('partials/scripts') %>
  </body>
</html>
